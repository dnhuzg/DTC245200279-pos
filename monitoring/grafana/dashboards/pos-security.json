      "title": "Bị rate limit (429)",
      "description": "Request bị Nginx chặn vì gửi quá nhanh",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
