# Sao chép file này thành .env rồi ĐỔI TOÀN BỘ mật khẩu trước khi chạy:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Linux/macOS)
# Mật khẩu nên >= 16 ký tự, có chữ hoa, chữ thường, số, ký tự đặc biệt.
# Tránh các ký tự  $ ` " ' \ #  và dấu cách vì dễ gây lỗi khi Docker Compose đọc biến.

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=Doi_MatKhau_Root@2026!
MYSQL_DATABASE=pos_db

# User riêng cho ứng dụng: chỉ có quyền SELECT/INSERT/UPDATE/DELETE trên pos_db
APP_DB_USER=pos_app
APP_DB_PASSWORD=Doi_MatKhau_App@2026!

# User cho mysqld-exporter: chỉ đọc trạng thái server (PROCESS, REPLICATION CLIENT)
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=Doi_MatKhau_Exporter@2026!

# ---------- Giám sát ----------
# Tài khoản quản trị Grafana (https://localhost/grafana/)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=Doi_MatKhau_Grafana@2026!

# Basic auth bảo vệ giao diện Prometheus (https://localhost/prometheus/)
PROMETHEUS_USER=prometheus
PROMETHEUS_PASSWORD=Doi_MatKhau_Prometheus@2026!

# ---------- Chung ----------
TZ=Asia/Ho_Chi_Minh
